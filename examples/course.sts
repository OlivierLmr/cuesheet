# The kinds a cuelight run mentions, and how they look.
kind point  asked
kind point  deliver
kind point  crash    kills
kind point  died     kills
kind point  recover  revives
kind point  end      kills
kind span   enter_cs exit_cs
kind span   paused
kind span   split

style diagram stretch=1.45 lane-pitch=170

style asked     mark=arrow color=#009e73
style deliver   mark=dot     color=#0072b2
style crash     mark=cross   color=#cc79a7
style died      mark=cross   color=#d55e00 label="exited on its own"
style recover   mark=ring    color=#009e73
style end       color=#878f9b

style .rb          label="rb" color=#0072b2
style enter_cs     fill=#d55e00 opacity=0.3 width=7 radius=3
style paused       fill=#c3c9d3 width=7
style split:network fill=#c3c9d3 opacity=0.25
